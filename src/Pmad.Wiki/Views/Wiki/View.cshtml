@model Pmad.Wiki.Models.WikiPageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="wiki-page">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Wiki" asp-action="View" asp-route-id="">@Localizer["Wiki"]</a></li>
                @foreach (var crumb in Model.Breadcrumb.Take(Model.Breadcrumb.Count - 1))
                {
                    <li class="breadcrumb-item"><a asp-controller="Wiki" asp-action="View" asp-route-id="@crumb.PageName">@crumb.PageTitle</a></li>
                }
                <li class="breadcrumb-item active" aria-current="page">@Model.Breadcrumb.Last().PageTitle</li>
            </ol>
        </nav>
        <div class="btn-toolbar" role="toolbar">
            @if (Model.AvailableCultures.Count > 1)
            {
                <div class="btn-group me-2" role="group">
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        @(Model.Culture ?? Localizer.GetString("Default"))
                    </button>
                    <ul class="dropdown-menu">
                        @foreach (var culture in Model.AvailableCultures)
                        {
                            <li>
                                <a class="dropdown-item @(culture == Model.Culture ? "active" : "")" 
                                   asp-action="View" 
                                   asp-route-id="@Model.PageName" 
                                   asp-route-culture="@culture">
                                    @culture
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
            <div class="btn-group" role="group">
                <a asp-action="SiteMap" class="btn btn-outline-secondary">
                    <i class="bi bi-map"></i> @Localizer["Site Map"]
                </a>
                <a asp-action="History" asp-route-id="@Model.PageName" asp-route-culture="@Model.Culture" class="btn btn-outline-secondary">
                    <i class="bi bi-clock-history"></i> @Localizer["History"]
                </a>
                @if (Model.CanEdit)
                {
                    <a asp-action="Create" asp-route-culture="@Model.Culture" asp-route-fromPage="@Model.PageName" class="btn btn-outline-primary" title="@Localizer["Create New Page"]">
                        <i class="bi bi-plus-circle"></i> @Localizer["Create"]
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.PageName" asp-route-culture="@Model.Culture" class="btn btn-primary">
                        <i class="bi bi-pencil"></i> @Localizer["Edit"]
                    </a>
                }
            </div>
        </div>
    </div>

    @if (Model.IsTemplate)
    {
        <div class="alert alert-info" role="alert">
            <p>@Localizer["This page is a template. It can be used to create a new page."]</p>
            @if (Model.CanEdit)
            {
                <a asp-action="CreatePage" asp-route-culture="@Model.Culture" asp-route-templateId="@Model.PageName" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    @Localizer["Use This Template"]
                </a>
            }
        </div>
    }

    @if (Model.IsSlideShow)
    {
        <div class="wiki-slideshow-wrapper">
            @Html.Raw(Model.HtmlContent)
            <div class="wiki-slideshow-btn-group">
                <button class="wiki-slideshow-action-btn" id="slideshow-fullpage-btn" title="@Localizer["Full Page"]">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
                <button class="wiki-slideshow-action-btn" id="slideshow-fullscreen-btn" title="@Localizer["Full Screen"]">
                    <i class="bi bi-fullscreen"></i>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="wiki-content">
            @Html.Raw(Model.HtmlContent)
        </div>
    }

    @if (Model.SubPages.Any())
    {
        <div class="mt-4">
            <h2 class="h5">@Localizer["Sub-pages"]</h2>
            <div class="wiki-sitemap-tree">
                @foreach (var node in Model.SubPages)
                {
                    @await Html.PartialAsync("_SubPageNode", node)
                }
            </div>
        </div>
    }

    @if (Model.LastModified.HasValue)
    {
        <div class="text-muted small mt-4">
            @if (!string.IsNullOrEmpty(Model.LastModifiedBy))
            {
                @Localizer["Last modified: {0:f} by {1}", Model.LastModified.Value, Model.LastModifiedBy]
            }
            else
            {
                @Localizer["Last modified: {0:f}", Model.LastModified.Value]
            }
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/pmad-wiki/css/style.css" />
    @if (Model.IsSlideShow)
    {
        <link rel="stylesheet" href="~/lib/revealjs/reveal.css" />
        <link rel="stylesheet" href="@Url.Content("~" + Model.SlideShowThemeUri)" />
    }
} 

@section Scripts {
    @if (Model.IsSlideShow)
    {
        <script src="~/lib/revealjs/reveal.js"></script>
        <script>
            Reveal.initialize(@Json.Serialize(Model.SlideShowConfig));

            (function () {
                var fullpageBtn = document.getElementById('slideshow-fullpage-btn');
                var fullscreenBtn = document.getElementById('slideshow-fullscreen-btn');
                var wrapper = document.querySelector('.wiki-slideshow-wrapper');

                fullpageBtn.addEventListener('click', function () {
                    var isFullpage = wrapper.classList.toggle('wiki-slideshow-fullpage');
                    document.body.style.overflow = isFullpage ? 'hidden' : '';
                    fullpageBtn.innerHTML = isFullpage
                        ? '<i class="bi bi-arrows-angle-contract"></i>'
                        : '<i class="bi bi-arrows-fullscreen"></i>';
                    Reveal.layout();
                });

                fullscreenBtn.addEventListener('click', function () {
                    if (document.fullscreenElement) {
                        document.exitFullscreen();
                    } else {
                        wrapper.requestFullscreen();
                    }
                });

                document.addEventListener('fullscreenchange', function () {
                    fullscreenBtn.innerHTML = document.fullscreenElement
                        ? '<i class="bi bi-fullscreen-exit"></i>'
                        : '<i class="bi bi-fullscreen"></i>';
                    Reveal.layout();
                });
            })();
        </script>
    }
    else
    {
        <script src="~/lib/pmad-wiki/js/view.js"></script>
    }
}
